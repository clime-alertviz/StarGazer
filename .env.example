# Copy to .env locally. Never commit the real values.
PORT=4317
HOST=127.0.0.1
STAR_GAZER_DATA_DIR=private/web
GEOAPIFY_API_KEY=
# Optional subscribed Open-Meteo endpoint; blank uses the public service.
OPEN_METEO_API_KEY=

# Matching/planning backend. Codex uses this server user's `codex login` account.
STAR_GAZER_SOLVER=codex
# Explicit alternative preserving the original planner: deterministic
# Optional model override; otherwise use the existing Codex configuration.
# STAR_GAZER_MODEL=
# STAR_GAZER_CODEX_BIN=/path/to/codex

# Optional locally; required when hosted: email for sign-in links and messages.
SMTP_URL=
MAIL_FROM=

# Optional: Google OAuth web application, for organizers sending Calendar invites.
# Enable Calendar API and Gmail API; add test users in the OAuth consent screen.
# Authorized redirect URI for this local setup:
# http://127.0.0.1:4317/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set the public HTTPS origin and a stable encryption key when hosted later.
# STAR_GAZER_BASE_URL=https://stargazer.example.com
# STAR_GAZER_ENCRYPTION_KEY=use-a-long-random-secret

# Only behind a reverse proxy: trusted proxy IPs/CIDRs, comma-separated.
# Leave unset for direct local access. The proxy must supply X-Forwarded-For.
# STAR_GAZER_TRUSTED_PROXIES=127.0.0.1,::1

# Codex client connections (same account as the web app). Keep tokens private.
# npm run codex passes these and the Geoapify/Open-Meteo keys to the local CLI.
# STAR_GAZER_URL=http://127.0.0.1:4317
# STAR_GAZER_TOKEN=generated-in-the-app-settings
